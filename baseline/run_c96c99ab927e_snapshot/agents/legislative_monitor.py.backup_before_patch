    """Legislative Monitor Agent for tracking bills and legislation."""
    
    def __init__(self, agent_id: str = None):
        super().__init__(agent_id or f"leg-monitor-{str(uuid.uuid4())[:8]}", "Legislative Monitor Agent")
        self.config = load_config()
        self.congress_gov_api_key = self.config.legislative_sources["congress_gov"]["api_key"]
        self.congress_gov_base_url = "https://api.congress.gov/v3"
        self.legiscan_api_key = self.config.legislative_sources["legiscan"]["api_key"]
        self.legiscan_base_url = "https://api.legiscan.com/"

    def execute_task(self, task_data: Dict[str, Any]) -> Dict[str, Any]:
        """Execute legislative monitoring tasks."""
        task_type = task_data.get("type", "unknown")
        
        self.log_thought(f"Legislative monitor received task: {task_type}")
        
        if task_type == "legislative_monitoring":
            return self._monitor_legislation(task_data)
        elif task_type == "track_bill":
            return self._track_bill(task_data)
        elif task_type == "analyze_amendments":
            return self._analyze_amendments(task_data)
        else:
            return {
                "status": "error",
                "message": f"Unknown task type: {task_type}",
                "agent_id": self.agent_id
            }

    def _get_congress_gov_bill(self, bill_type: str, bill_number: int, congress: int) -> Optional[Dict[str, Any]]: 
        """Fetch a specific bill from Congress.gov API."""
        if not self.congress_gov_api_key:
            self.log_thought("Congress.gov API key not configured, skipping API call")
            return None
            
        try:
            url = f"{self.congress_gov_base_url}/{congress}/bills/{bill_type}/{bill_number}"
            params = {
                "api_key": self.congress_gov_api_key,
                "format": "json"
            }
            
            response = requests.get(url, params=params, timeout=30)
            if response.status_code == 200:
                data = response.json()
                bill = data.get("bill", {})
                if bill:
                    # Extract relevant information
                    return {
                        "bill_id": f"{bill_type.upper()}-{bill_number}-{congress}",
                        "title": bill.get("title", ""),
                        "sponsor": self._get_sponsor_name(bill.get("sponsors", [])),
                        "introduced_date": bill.get("introducedDate", ""),
                        "latest_action": bill.get("latestAction", {}).get("text", ""),
                        "url": bill.get("url", ""),
                        "keywords": self._extract_keywords_from_bill(bill),
                        "relevance_score": 0.95  # High relevance for specific bill lookup
                    }
            else:
                self.log_thought(f"Congress.gov API returned status {response.status_code} for {bill_type} {bill_number}")
                
        except Exception as e:
            self.log_thought(f"Error fetching bill {bill_type} {bill_number} from Congress.gov: {e}")
            
        return None
    
    def _search_congress_gov_bills(self, query: str, congress: int, limit: int = 10) -> List[Dict[str, Any]]:
        """Search for bills on Congress.gov API."""
        if not self.congress_gov_api_key:
            self.log_thought("Congress.gov API key not configured, skipping API call")
            return []
            
        try:
            url = f"{self.congress_gov_base_url}/{congress}/bills"
            params = {
                "query": query,
                "api_key": self.congress_gov_api_key,
                "format": "json",
                "pageSize": limit
            }
            
            response = requests.get(url, params=params, timeout=30)
            if response.status_code == 200:
                data = response.json()
                bills = data.get("bills", [])
                results = []
                
                for bill in bills:
                    bill_info = {
                        "bill_id": f"{bill.get('type', '')}-{bill.get('number', '')}-{congress}",
                        "title": bill.get("title", ""),
                        "sponsor": self._get_sponsor_name(bill.get("sponsors", [])),
                        "introduced_date": bill.get("introducedDate", ""),
                        "latest_action": bill.get("latestAction", {}).get("text", ""),
                        "url": bill.get("url", ""),
                        "keywords": self._extract_keywords_from_bill(bill),
                        "relevance_score": 0.8  # Good relevance for search results
                    }
                    results.append(bill_info)
                
                return results
            else:
                self.log_thought(f"Congress.gov search API returned status {response.status_code} for query '{query}'")
                
        except Exception as e:
            self.log_thought(f"Error searching bills on Congress.gov: {e}")
            
        return []
    
    def _get_sponsor_name(self, sponsors: List[Dict[str, Any]]) -> str:
        """Extract sponsor name from sponsors list."""
        if not sponsors:
            return ""
        # Get the first sponsor
        sponsor = sponsors[0] if isinstance(sponsors, list) else {}
        first_name = sponsor.get("firstName", "")
        last_name = sponsor.get("lastName", "")
        middle_name = sponsor.get("middleName", "")
        name_parts = [first_name, middle_name, last_name]
        return " ".join(part for part in name_parts if part).strip()
    
    def _extract_keywords_from_bill(self, bill: Dict[str, Any]) -> List[str]:
        """Extract relevant keywords from bill data."""
        keywords = []
        # Add bill type and number
        bill_type = bill.get("type", "")
        bill_number = bill.get("number", "")
        if bill_type and bill_number:
            keywords.append(f"{bill_type.upper()} {bill_number}")
        
        # Add policy area if available
        policy_area = bill.get("policyArea", "")
        if policy_area:
            keywords.append(policy_area.lower().replace(" ", "_"))
        
        # Add subjects if available
        subjects = bill.get("subjects", [])
        if isinstance(subjects, list):
            for subject in subjects:
                if isinstance(subject, dict):
                    subject_name = subject.get("name", "")
                    if subject_name:
                        keywords.append(subject_name.lower().replace(" ", "_"))
                elif isinstance(subject, str):
                    keywords.append(subject.lower().replace(" ", "_"))
        
        # Add BNPL-related terms if present in title
        title = bill.get("title", "").lower()
        bnpl_terms = ["buy now pay later", "bnpl", "installment loan", "point of sale", "pos lending"]
        for term in bnpl_terms:
            if term in title:
                keywords.append(term.replace(" ", "_"))
                
        return list(set(keywords))  # Remove duplicates
    
    def _get_legiscan_bill(self, bill_id: int) -> Optional[Dict[str, Any]]:
        """Fetch a specific bill from LegiScan API."""
        if not self.legiscan_api_key:
            self.log_thought("LegiScan API key not configured, skipping API call")
            return None
        try:
            url = self.legiscan_base_url
            params = {
                "key": self.legiscan_api_key,
                "op": "getBill",
                "id": bill_id
            }
            response = requests.get(url, params=params, timeout=30)
            if response.status_code == 200:
                data = response.json()
                if data.get("status") == "OK":
                    bill_data = data.get("bill", {})
                    # Normalize to our internal schema
                    return {
                        "bill_id": f"LEGISCAN-{bill_data.get('bill_id')}",
                        "title": bill_data.get("title", ""),
                        "sponsor": self._get_legiscan_sponsor_name(bill_data.get("sponsors", [])),
                        "introduced_date": bill_data.get("introduced_date", ""),
                        "latest_action": bill_data.get("last_action", ""),
                        "url": bill_data.get("url", ""),
                        "keywords": self._extract_keywords_from_legiscan_bill(bill_data),
                        "relevance_score": 0.9
                    }
                else:
                    self.log_thought(f"LegiScan API returned error: {data.get('message')}")
            else:
                self.log_thought(f"LegiScan API returned status {response.status_code}")
        except Exception as e:
            self.log_thought(f"Error fetching bill from LegiScan: {e}")
        return None

    def _search_legiscan_bills(self, query: str, state: Optional[str] = None) -> List[Dict[str, Any]]:
        """Search for bills on LegiScan API."""
        if not self.legiscan_api_key:
            self.log_thought("LegiScan API key not configured, skipping API call")
            return []
        try:
            url = self.legiscan_base_url
            params = {
                "key": self.legiscan_api_key,
                "op": "getSearchResults",
                "query": query
            }
            if state:
                params["state"] = state
            response = requests.get(url, params=params, timeout=30)
            if response.status_code == 200:
                data = response.json()
                if data.get("status") == "OK":
                    # The search results are in data["result"]["summary"]
                    bills = data.get("result", {}).get("summary", [])
                    results = []
                    for bill in bills:
                        # Normalize each bill
                        bill_info = {
                            "bill_id": f"LEGISCAN-{bill.get('bill_id')}",
                            "title": bill.get("title", ""),
                            "sponsor": self._get_legiscan_sponsor_name(bill.get("sponsors", [])),
                            "introduced_date": bill.get("introduced_date", ""),
                            "latest_action": bill.get("last_action", ""),
                            "url": bill.get("url", ""),
                            "keywords": self._extract_keywords_from_legiscan_bill(bill),
                            "relevance_score": 0.8
                        }
                        results.append(bill_info)
                    return results
                else:
                    self.log_thought(f"LegiScan search API returned error: {data.get('message')}")
            else:
                self.log_thought(f"LegiScan search API returned status {response.status_code}")
        except Exception as e:
            self.log_thought(f"Error searching LegiScan: {e}")
        return []

    def _get_legiscan_sponsor_name(self, sponsors: List[Dict[str, Any]]) -> str:
        """Extract sponsor name from sponsors list."""
        if not sponsors:
            return ""
        # Get the first sponsor
        sponsor = sponsors[0] if isinstance(sponsors, list) else {}
        first_name = sponsor.get("firstName", "")
        last_name = sponsor.get("lastName", "")
        middle_name = sponsor.get("middleName", "")
        name_parts = [first_name, middle_name, last_name]
