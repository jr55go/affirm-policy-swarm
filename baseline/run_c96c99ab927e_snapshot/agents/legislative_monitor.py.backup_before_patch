    def _extract_keywords_from_legiscan_bill(self, bill: Dict[str, Any]) -> List[str]:
        """Extract relevant keywords from bill data."""
        keywords = []
        bill_id = bill.get("bill_id")
        if bill_id:
            keywords.append(f"LEGISCAN-{bill_id}")
        title = bill.get("title", "").lower()
        # Add policy area if available
        policy_area = bill.get("policyArea", "")
        if policy_area:
            keywords.append(policy_area.lower().replace(" ", "_"))
        # Add subjects if available
        subjects = bill.get("subjects", [])
        if isinstance(subjects, list):
            for subject in subjects:
                if isinstance(subject, dict):
                    subject_name = subject.get("name", "")
                    if subject_name:
                        keywords.append(subject_name.lower().replace(" ", "_"))
                elif isinstance(subject, str):
                    keywords.append(subject.lower().replace(" ", "_"))
        # Add BNPL-related terms if present in title
        bnpl_terms = ["buy now pay later", "bnpl", "installment loan", "point of sale", "pos lending"]
        for term in bnpl_terms:
            if term in title:
                keywords.append(term.replace(" ", "_"))
        return list(set(keywords))  # Remove duplicates

    def _fetch_legislative_data(self, jurisdiction: str, product: str, lookback_hours: int) -> List[Dict[str, Any]]:
        """Fetch legislative data from APIs based on jurisdiction and product."""
        # In production mode, use real APIs. In development/mock, simulate.
        if self.config.swarm_mode == "production":
            self.log_thought(f"Fetching LEGISLATIVE data for {product} in {jurisdiction} (last {lookback_hours}h) from LIVE APIs")
            
            legislative_items = []
            
            if jurisdiction == "US Federal":
                # Search for BNPL bills in current Congress (118th as of 2024)
                congress = 118
                query = "buy now pay later"
                congressional_bills = self._search_congress_gov_bills(query, congress, limit=10)
                legislative_items.extend(congressional_bills)
                
                # Also search for specific BNPL-related terms
                query2 = "point of sale lending"
                congressional_bills2 = self._search_congress_gov_bills(query2, congress, limit=5)
                legislative_items.extend(congressional_bills2)
                
            elif jurisdiction == "California":
                # Search for BNPL bills in California via LegiScan
                query = "buy now pay later"
                california_bills = self._search_legiscan_bills(query, state="CA")
                legislative_items.extend(california_bills)
                
                # Also search for installment loans
                query2 = "installment loan"
                california_bills2 = self._search_legiscan_bills(query2, state="CA")
                legislative_items.extend(california_bills2)
                
            else:
                # For other jurisdictions, fall back to simulation for now
                self.log_thought(f"Jurisdiction {jurisdiction} not implemented for live API, simulating")
                legislative_items = self._simulate_legislative_data(jurisdiction, product, lookback_hours)
                
            # Remove duplicates based on bill_id
            seen_ids = set()
            unique_items = []
            for item in legislative_items:
                bid = item.get("bill_id")
                if bid and bid not in seen_ids:
                    seen_ids.add(bid)
                    unique_items.append(item)
                    
            self.log_thought(f"Fetched {len(unique_items)} unique legislative items from live APIs")
            return unique_items
        else:
            # Development/mock mode - simulate data
            self.log_thought(f"Fetching legislative data for {product} in {jurisdiction} (last {lookback_hours}h) - SIMULATED")
            return self._simulate_legislative_data(jurisdiction, product, lookback_hours)
    
