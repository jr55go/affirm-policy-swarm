    logging.basicConfig(level=logging.INFO)
    
    agent = ImpactAnalyzerAgent()
    
    # Test policy impact analysis
    result = agent.execute_task({
        "type": "analyze_policy_impact",
        "policy_id": "CFPB-2024-BNPL-001",
        "policy_description": "Proposed regulation on Buy Now, Pay Later services requiring clearer disclosures and payment limits",
        "jurisdiction": "US Federal",
        "affected_products": ["Buy Now, Pay Later", "Point-of-sale financing"]
    })
    
    print("Impact analysis result:")
    print(f"Status: {result['status']}")
    print(f"Policy ID: {result.get('policy_id')}")
    print(f"Jurisdiction: {result.get('jurisdiction')}")
    print(f"Overall Impact Score: {result.get('overall_impact_score', 0):.3f}")
    print(f"Economic Impact: {result.get('economic_impact', {}).get('impact_score', 0):.3f}")
    print(f"Social Impact: {result.get('social_impact', {}).get('impact_score', 0):.3f}")
    print(f"Environmental Impact: {result.get('environmental_impact', {}).get('impact_score', 0):.3f}")