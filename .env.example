# Existing production source credentials
CONGRESS_GOV_API_KEY=
LEGISCAN_API_KEY=
LEXISNEXIS_API_KEY=
REGULATIONS_GOV_API_KEY=

# Independent dashboard ingestion
# Example: https://your-dashboard-domain.example/api/ingest/v1/runs
DASHBOARD_INGEST_URL=
# Must exactly match the dashboard server's SWARM_INGEST_TOKEN and be at least 32 characters.
DASHBOARD_INGEST_TOKEN=
DASHBOARD_INGEST_TIMEOUT_SECONDS=30

# Optional immutable release identifier when Git metadata is unavailable at runtime.
SWARM_CODE_VERSION=
